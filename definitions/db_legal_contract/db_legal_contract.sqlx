config {
    type: "incremental",
    protected: true,
    description: "db_legal_contract dimension table",
    uniqueKey: ["Contr_Id", "Valid_From_Dt", "Fin_Rep_Valid_From_Mth"],
    bigquery: {
        partitionBy: "TIMESTAMP_TRUNC(UPDATE_LOAD_TS, MONTH)"
    },
    tags: ["Semantic", "Dimension", "db_legal_contract"]
}

pre_operations {
  delete from ${self()} where true;

  -- SELECT
  --   ERROR(
  --     """
  --     Error: Cannot write NULL to Ident_Type_Cd field
      
  --     """
  --   );

}

SELECT CAST(stg_s_asspd_hist_d_leg_contr_90.Contr_id AS STRING) AS Contr_Id,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Valid_From_Dt AS DATE) AS Valid_From_Dt,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Valid_Until_Dt AS DATE) AS Valid_Until_Dt,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Current_Ind AS STRING) AS Current_Ind,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Ident_Type_Cd AS STRING) AS Ident_Type_Cd,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Ident_1_Num AS STRING) AS Ident_1_Num,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Ident_2_Num AS STRING) AS Ident_2_Num,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Ident_3_Num AS STRING) AS Ident_3_Num,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Ident_4_Num AS STRING) AS Ident_4_Num,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Contr_Num AS STRING) AS Contr_Num,
