       CAST(stg_s_asspd_hist_d_leg_contr_90.Subtype_Cd AS STRING) AS Subtype_Cd,
       CAST(NULL AS STRING) AS Region_Cd,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Conv_Status_Cd AS STRING) AS Conv_Status_Cd,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Conv_Status_Dt AS DATE) AS Conv_Status_Dt,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Last_Subsd_Dt AS DATE) AS Last_Subsd_Dt,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Sign_Dt AS DATE) AS Sign_Dt,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Receive_Dt AS DATE) AS Receive_Dt,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Orig_Start_Dt AS DATE) AS Orig_Start_Dt,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Plan_Expir_Dt AS DATE) AS Plan_Expir_Dt,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Commit_Period_Start_Dt AS DATE) AS Commit_Period_Start_Dt,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Next_Subsd_Dt AS DATE) AS Next_Subsd_Dt,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Tariff_Offer_Id AS STRING) AS Tariff_Offer_Id,
