       CAST(stg_s_asspd_hist_d_leg_contr_90.Init_Contr_Per_Uom_Cd AS STRING) AS Init_Contr_Per_Uom_Cd,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Init_Term_Time_Point_Cd AS STRING) AS Init_Term_Time_Point_Cd,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Init_Term_Notice_Per_Qty AS INT64) AS Init_Term_Notice_Per_Qty,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Init_Term_Notice_Per_UOM_Cd AS STRING) AS Init_Term_Notice_Per_Uom_Cd,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Subsq_Contr_Per_Qty AS INT64) AS Subsq_Contr_Per_Qty,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Subsq_Contr_Per_Uom_Cd AS STRING) AS Subsq_Contr_Per_Uom_Cd,
       CAST(stg_s_asspd_hist_d_leg_contr_90.Subsq_Term_Time_Point_Cd AS STRING) AS Subsq_Term_Time_Point_Cd,
